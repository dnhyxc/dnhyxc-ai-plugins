{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@ui/*": ["./src/components/ui/*"],
			"@design/*": ["./src/components/design/*"]
		}
	},
	"include": ["src"],
	"exclude": ["src/**/*.selfcheck.ts"]
}
